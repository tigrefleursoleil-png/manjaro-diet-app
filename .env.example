# ===== 必須 =====
# Anthropic API キー（https://console.anthropic.com で発行）
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# ===== サーバー =====
PORT=8787
# ウィジェットを埋め込むページのオリジン（カンマ区切り / * は開発時のみ）
ALLOWED_ORIGINS=http://localhost:8787,https://example.clinic

# ===== 学習対象のホームページ =====
# このURLを起点に同一ドメイン内を巡回して最新情報を取り込みます
SITE_URL=https://example.clinic
CRAWL_MAX_PAGES=120
CRAWL_MAX_DEPTH=3
# 再クロール間隔（分）。0 で自動再クロール無効
CRAWL_INTERVAL_MINUTES=360
# 起動直後にクロールする
CRAWL_ON_BOOT=true

# ===== モデル =====
BOT_MODEL=claude-opus-5
# low / medium / high / xhigh / max
BOT_EFFORT=low

# ===== 運用 =====
# /api/admin/refresh を叩くためのトークン（未設定なら管理APIは無効）
ADMIN_TOKEN=
# 1IPあたり 1分間の質問回数上限
RATE_LIMIT_PER_MIN=12
# 会話ログを data/conversations.jsonl に保存する
LOG_CONVERSATIONS=true
