# systemd で常駐させる場合の例
#   sudo cp deploy/clinic-chat.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now clinic-chat
[Unit]
Description=Clinic AI Chat (patient FAQ bot)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=clinic
WorkingDirectory=/opt/clinic-chat
EnvironmentFile=/opt/clinic-chat/.env
ExecStart=/usr/bin/node dist/server.js
Restart=always
RestartSec=5
# 書き込みは data/ だけに限定する
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/clinic-chat/data

[Install]
WantedBy=multi-user.target
