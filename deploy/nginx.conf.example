# nginx をリバースプロキシにする場合の例（TLS は certbot で取得）
#   sudo certbot --nginx -d chat.example.clinic
server {
    listen 443 ssl http2;
    server_name chat.example.clinic;

    ssl_certificate     /etc/letsencrypt/live/chat.example.clinic/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/chat.example.clinic/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # ★ ストリーミング応答（SSE）に必須。これが無いと回答が一気に遅れて届きます
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
    }

    # 管理APIは院内IPだけに絞る場合の例
    # location /api/admin/ {
    #     allow 203.0.113.0/24;
    #     deny all;
    #     proxy_pass http://127.0.0.1:8787;
    # }
}

server {
    listen 80;
    server_name chat.example.clinic;
    return 301 https://$host$request_uri;
}
